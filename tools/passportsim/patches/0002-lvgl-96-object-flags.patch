+    /// LVGL 9.6 keeps the common object layout but exposes flag bits as bitfields at byte 44.
+    pub fn layouts_v96() -> Layouts {
+        let original = layouts();
+        let mut result = Layouts::new();
+        for layout in original.iter().filter(|layout| layout.name != "_lv_obj_t") {
+            result.insert(layout.clone());
+        }
+        let old = original.get("_lv_obj_t").expect("synthetic object layout");
+        let mut members: Vec<_> = old
+            .members()
+            .iter()
+            .filter(|member| member.path != "flags")
+            .cloned()
+            .collect();
+        members.extend([
+            bitfield("hidden", 44, 0, 1),
+            bitfield("clickable", 44, 1, 1),
+            bitfield("scrollable", 44, 4, 1),
+            bitfield("floating", 44, 18, 1),
+        ]);
+        result.insert(StructLayout::new("_lv_obj_t", 56, members));
+        result
+    }
+
