+/// LVGL 9.5 stores the object flags as a packed word. LVGL 9.6 exposes the same bits as
+/// individual DWARF bitfields. Prefer the packed representation when available, and require the
+/// two bits needed for visibility and semantic pruning before accepting the bitfield layout.
+fn read_object_flags(
+    object: &crate::layout::StructLayout,
+    mem: &dyn GuestMemory,
+    obj: u32,
+) -> Result<u32, IntrospectError> {
+    if object.member("flags").is_some() {
+        return object.u32(mem, obj, "flags");
+    }
+    let hidden = object.flag(mem, obj, "hidden")?;
+    let clickable = object.flag(mem, obj, "clickable")?;
+    let mut flags = 0;
+    for (member, mask, required_value) in [
+        ("hidden", FLAG_HIDDEN, hidden),
+        ("clickable", FLAG_CLICKABLE, clickable),
+        ("scrollable", FLAG_SCROLLABLE, false),
+        ("floating", FLAG_FLOATING, false),
+    ] {
+        let value = if member == "hidden" || member == "clickable" {
+            required_value
+        } else if object.member(member).is_some() {
+            object.flag(mem, obj, member)?
+        } else {
+            false
+        };
+        if value {
+            flags |= mask;
+        }
+    }
+    Ok(flags)
+}
